<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بازارچه آنلاین مشابه باسلام</title>
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Vazirmatn', 'sans-serif'] },
                    colors: {
                        basalam: {
                            DEFAULT: '#008b8b',
                            dark: '#006666',
                            orange: '#ff6b35',
                            bg: '#f8f9fa'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Vazirmatn', sans-serif; background-color: #f8f9fa; }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .scrollbar-none::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="text-gray-800 antialiased flex flex-col min-h-screen">

    <!-- هدر سایت -->
    <header class="bg-white shadow-sm sticky top-0 z-40 border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <div class="bg-basalam text-white w-10 h-10 rounded-xl flex items-center justify-center font-black text-xl shadow-md">با</div>
                <span class="font-extrabold text-2xl text-basalam hidden sm:inline">بازارچه</span>
            </div>
            <div class="flex-1 max-w-2xl relative">
                <input type="text" id="searchInput" oninput="handleSearch()" placeholder="جستجو در بین هزاران محصول و غرفه..." 
                       class="w-full bg-gray-100 border border-gray-300 rounded-full py-2.5 pr-11 pl-4 text-sm focus:outline-none focus:border-basalam focus:bg-white transition">
                <i class="fa-solid fa-magnifying-glass absolute right-4 top-3.5 text-gray-400"></i>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="toggleCartDrawer()" class="relative bg-gray-100 hover:bg-gray-200 p-2.5 rounded-full text-gray-700 transition">
                    <i class="fa-solid fa-cart-shopping text-lg"></i>
                    <span id="cartBadge" class="hidden absolute -top-1 -right-1 bg-basalam-orange text-white text-xs font-bold w-5 h-5 rounded-full items-center justify-center">0</span>
                </button>
                <button class="hidden md:flex items-center gap-2 border border-gray-300 px-4 py-2 rounded-xl text-sm font-semibold hover:bg-gray-50 transition">
                    <i class="fa-regular fa-user"></i>
                    <span>ورود / ثبت‌نام</span>
                </button>
            </div>
        </div>
        <div class="border-t border-gray-100 bg-white">
            <div class="max-w-7xl mx-auto px-4 flex items-center gap-2 overflow-x-auto py-2.5 text-sm scrollbar-none" id="categoriesNav"></div>
        </div>
    </header>

    <!-- بنر تبلیغاتی -->
    <section class="max-w-7xl mx-auto px-4 pt-6">
        <div class="bg-gradient-to-r from-teal-700 to-basalam rounded-3xl p-6 sm:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-md">
            <div class="space-y-3 text-center md:text-right">
                <span class="bg-white/20 text-xs px-3 py-1 rounded-full font-medium">بازارچه بی‌واسطه باسلامی</span>
                <h1 class="text-2xl sm:text-4xl font-black leading-tight">خرید مستقیم از غرفه‌داران سراسر ایران</h1>
                <p class="text-teal-100 text-sm sm:text-base max-w-xl">از محصولات خانگی تا تجهیزات دیجیتال و کمپینگ با بهترین قیمت و ضمانت بازگشت وجه.</p>
            </div>
            <div class="flex-shrink-0">
                <span class="inline-block bg-basalam-orange text-white font-bold px-6 py-3 rounded-2xl shadow-lg transform hover:scale-105 transition cursor-pointer">تخفیف‌های ویژه امروز</span>
            </div>
        </div>
    </section>

    <!-- گريد محصولات -->
    <main class="max-w-7xl mx-auto px-4 py-8 flex-1">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-extrabold text-gray-800 border-r-4 border-basalam pr-3" id="sectionTitle">محصولات منتخب</h2>
            <span id="productCount" class="text-sm text-gray-500 font-medium">۶ محصول</span>
        </div>
        <div id="productGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6"></div>
    </main>

    <!-- کشوی سبد خرید -->
    <div id="cartDrawer" class="fixed inset-0 z-50 invisible transition-all duration-300">
        <div id="cartOverlay" onclick="toggleCartDrawer()" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"></div>
        <div class="absolute inset-y-0 left-0 max-w-full w-96 bg-white shadow-2xl flex flex-col transform -translate-x-full transition-transform duration-300" id="cartPanel">
            <div class="p-4 border-b flex justify-between items-center bg-gray-50">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-basket-shopping text-basalam"></i>
                    <h3 class="font-bold text-lg">سبد خرید شما</h3>
                </div>
                <button onclick="toggleCartDrawer()" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <div id="cartItems" class="flex-1 overflow-y-auto p-4 space-y-4 divide-y divide-gray-100"></div>
            <div class="p-4 border-t bg-gray-50 space-y-3">
                <div class="flex justify-between items-center text-gray-600 text-sm">
                    <span>مبلغ قابل پرداخت:</span>
                    <span id="cartTotalPrice" class="font-extrabold text-lg text-basalam">۰ تومان</span>
                </div>
                <button onclick="checkout()" class="w-full bg-basalam-orange hover:bg-orange-600 text-white font-bold py-3 rounded-xl shadow-md transition">تکمیل خرید و ثبت سفارش</button>
            </div>
        </div>
    </div>

    <!-- فوتور -->
    <footer class="bg-white border-t border-gray-200 mt-12 py-8 text-center text-sm text-gray-500">
        <div class="max-w-7xl mx-auto px-4">
            <p>© ۱۴۰۵ تمامی حقوق برای این نمونه‌ی بازارچه آنلاین محفوظ است.</p>
            <p class="mt-2 text-xs text-gray-400">طراحی شده با جاوا اسکریپت و Tailwind CSS</p>
        </div>
    </footer>

    <script>
        const products = [
            { id: 1, title: 'کفش رانینگ مردانه اسپرت برند نایکی', shop: 'غرفه اسپرت لند', location: 'تهران', price: 1850000, oldPrice: 2200000, category: 'shoes', rating: 4.8, reviews: 42, image: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&q=80' },
            { id: 2, title: 'کنسول بازی پلی استیشن 5 استاندارد (PS5)', shop: 'غرفه دیجی گیم تک', location: 'اصفهان', price: 32500000, oldPrice: 34000000, category: 'digital', rating: 4.9, reviews: 128, image: 'https://images.unsplash.com/photo-1606813907291-d86efa9b94db?w=600&q=80' },
            { id: 3, title: 'چادر کوهنوردی ۴ نفره ضدآب دوپوش', shop: 'غرفه تجهیزات طبیعت‌گردی آریا', location: 'شیراز', price: 3400000, oldPrice: 3900000, category: 'camping', rating: 4.6, reviews: 19, image: 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=600&q=80' },
            { id: 4, title: 'کوله پشتی ۶۰ لیتری حرفه‌ای سفری', shop: 'غرفه تجهیزات طبیعت‌گردی آریا', location: 'شیراز', price: 2150000, oldPrice: 2500000, category: 'camping', rating: 4.7, reviews: 31, image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=80' },
            { id: 5, title: 'عسل طبیعی ۱۰۰٪ خالص خوانسار (یک کیلویی)', shop: 'غرفه شهد کوهستان', location: 'خوانسار', price: 480000, oldPrice: 550000, category: 'food', rating: 5.0, reviews: 210, image: 'https://images.unsplash.com/photo-1587049352846-4a222e784d38?w=600&q=80' },
            { id: 6, title: 'کیف دوشی چرم طبیعی دست‌دوز زنانه', shop: 'غرفه چرم اصیل تبریز', location: 'تبریز', price: 1450000, oldPrice: 1800000, category: 'shoes', rating: 4.5, reviews: 14, image: 'https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=600&q=80' }
        ];

        const categories = [
            { id: 'all', name: 'همه محصولات', icon: 'fa-border-all' },
            { id: 'shoes', name: 'کفش و پوشاک', icon: 'fa-shoe-prints' },
            { id: 'digital', name: 'کنسول و دیجیتال', icon: 'fa-gamepad' },
            { id: 'camping', name: 'وسایل طبیعت‌گردی', icon: 'fa-campground' },
            { id: 'food', name: 'خوراکی و ارگانیک', icon: 'fa-apple-whole' }
        ];

        let cart = [];
        let activeCategory = 'all';

        function formatPrice(price) { return new Intl.NumberFormat('fa-IR').format(price) + ' تومان'; }
        function toPersianDigits(n) {
            const farsiDigits = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
            return n.toString().replace(/\d/g, x => farsiDigits[x]);
        }

        function renderCategories() {
            const nav = document.getElementById('categoriesNav');
            nav.innerHTML = categories.map(cat => `
                <button onclick="setCategory('${cat.id}')" 
                        class="px-4 py-2 rounded-xl whitespace-nowrap text-sm font-medium transition flex items-center gap-2 ${activeCategory === cat.id ? 'bg-basalam text-white shadow-sm' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}">
                    <i class="fa-solid ${cat.icon}"></i><span>${cat.name}</span>
                </button>
            `).join('');
        }

        function setCategory(catId) { activeCategory = catId; renderCategories(); filterProducts(); }

        function renderProducts(items) {
            const grid = document.getElementById('productGrid');
            const countLabel = document.getElementById('productCount');
            countLabel.textContent = `${toPersianDigits(items.length)} محصول`;
            if (items.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 text-gray-500"><i class="fa-solid fa-box-open text-4xl mb-3 block"></i>محصولی با این مشخصات یافت نشد.</div>`;
                return;
            }
            grid.innerHTML = items.map(p => {
                const discount = Math.round(((p.oldPrice - p.price) / p.oldPrice) * 100);
                return `
                    <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg transition flex flex-col justify-between group">
                        <div>
                            <div class="relative overflow-hidden aspect-square bg-gray-100">
                                <img src="${p.image}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                                <span class="absolute top-2 right-2 bg-basalam-orange text-white text-xs font-bold px-2 py-1 rounded-lg">${toPersianDigits(discount)}٪</span>
                            </div>
                            <div class="p-3.5 space-y-2">
                                <div class="flex items-center justify-between text-xs text-gray-400">
                                    <span class="truncate"><i class="fa-store fa-solid ml-1"></i>${p.shop}</span>
                                    <span>${p.location}</span>
                                </div>
                                <h3 class="text-sm font-bold text-gray-800 line-clamp-2 h-10 leading-snug">${p.title}</h3>
                                <div class="flex items-center gap-1 text-xs text-amber-500 font-semibold">
                                    <i class="fa-solid fa-star"></i><span>${toPersianDigits(p.rating)}</span>
                                    <span class="text-gray-400">(${toPersianDigits(p.reviews)})</span>
                                </div>
                            </div>
                        </div>
                        <div class="p-3.5 pt-0 space-y-3">
                            <div class="text-left">
                                <span class="text-xs text-gray-400 line-through block">${formatPrice(p.oldPrice)}</span>
                                <span class="text-base font-extrabold text-basalam-dark">${formatPrice(p.price)}</span>
                            </div>
                            <button onclick="addToCart(${p.id})" class="w-full bg-teal-50 hover:bg-basalam hover:text-white text-basalam border border-teal-200 font-bold py-2 rounded-xl text-sm transition flex items-center justify-center gap-2">
                                <i class="fa-solid fa-plus text-xs"></i><span>افزودن به سبد</span>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function filterProducts() {
            const query = document.getElementById('searchInput').value.trim().toLowerCase();
            const filtered = products.filter(p => {
                const matchesCategory = activeCategory === 'all' || p.category === activeCategory;
                const matchesSearch = p.title.toLowerCase().includes(query) || p.shop.toLowerCase().includes(query);
                return matchesCategory && matchesSearch;
            });
            renderProducts(filtered);
        }

        function handleSearch() { filterProducts(); }

        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            const existItem = cart.find(item => item.id === productId);
            if (existItem) existItem.quantity++;
            else cart.push({ ...product, quantity: 1 });
            updateCartUI();
            toggleCartDrawer(true);
        }

        function updateQuantity(productId, change) {
            const item = cart.find(i => i.id === productId);
            if (!item) return;
            item.quantity += change;
            if (item.quantity <= 0) cart = cart.filter(i => i.id !== productId);
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cartBadge');
            const cartItemsContainer = document.getElementById('cartItems');
            const totalPriceEl = document.getElementById('cartTotalPrice');
            const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

            if (totalCount > 0) {
                badge.textContent = toPersianDigits(totalCount);
                badge.classList.remove('hidden');
                badge.classList.add('flex');
            } else {
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            }
            totalPriceEl.textContent = formatPrice(totalPrice);

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `<div class="text-center py-12 text-gray-400"><i class="fa-solid fa-cart-arrow-down text-4xl mb-3 block"></i>سبد خرید شما خالی است.</div>`;
                return;
            }

            cartItemsContainer.innerHTML = cart.map(item => `
                <div class="flex items-center gap-3 pt-3">
                    <img src="${item.image}" class="w-16 h-16 rounded-xl object-cover border border-gray-100">
                    <div class="flex-1 min-w-0">
                        <h4 class="text-xs font-bold text-gray-800 truncate">${item.title}</h4>
                        <span class="text-xs text-basalam font-semibold block mt-1">${formatPrice(item.price)}</span>
                        <div class="flex items-center gap-2 mt-2">
                            <button onclick="updateQuantity(${item.id}, -1)" class="w-6 h-6 bg-gray-100 rounded-md flex items-center justify-center text-xs text-gray-600 hover:bg-gray-200">-</button>
                            <span class="text-xs font-bold">${toPersianDigits(item.quantity)}</span>
                            <button onclick="updateQuantity(${item.id}, 1)" class="w-6 h-6 bg-gray-100 rounded-md flex items-center justify-center text-xs text-gray-600 hover:bg-gray-200">+</button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function toggleCartDrawer(open = null) {
            const drawer = document.getElementById('cartDrawer');
            const overlay = document.getElementById('cartOverlay');
            const panel = document.getElementById('cartPanel');
            const isOpening = open !== null ? open : drawer.classList.contains('invisible');

            if (isOpening) {
                drawer.classList.remove('invisible');
                setTimeout(() => {
                    overlay.classList.add('opacity-100');
                    panel.classList.remove('-translate-x-full');
                }, 10);
            } else {
                overlay.classList.remove('opacity-100');
                panel.classList.add('-translate-x-full');
                setTimeout(() => {
                    drawer.classList.add('invisible');
                }, 300);
            }
        }

        function checkout() {
            if (cart.length === 0) {
                alert('سبد خرید شما خالی است!');
                return;
            }
            alert('سفارش شما با موفقیت ثبت شد! (نمونه)');
            cart = [];
            updateCartUI();
            toggleCartDrawer(false);
        }

        // اجرای اولیه
        renderCategories();
        renderProducts(products);
    </script>
</body>
</html>
